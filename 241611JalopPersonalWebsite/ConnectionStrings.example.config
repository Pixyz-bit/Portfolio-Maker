<?xml version="1.0" encoding="utf-8" ?>
<!-- 
  CONNECTION STRINGS TEMPLATE (Safe for Git / GitHub)
  Copy this file to 'ConnectionStrings.config' and fill in your actual credentials.
-->
<connectionStrings>
  <!-- Remote database (databaseasp.net) -->
  <add name="DefaultConnection"
       connectionString="Server=YOUR_SERVER.databaseasp.net; Database=YOUR_DATABASE; User Id=YOUR_USERNAME; Password=YOUR_PASSWORD; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True; Connection Timeout=30;"
       providerName="System.Data.SqlClient" />

  <!-- Local SQL Server instance -->
  <add name="LocalConnection"
       connectionString="Data Source=.;Initial Catalog=IPTPersonalWebsite;Integrated Security=True;TrustServerCertificate=True;"
       providerName="System.Data.SqlClient" />
</connectionStrings>
